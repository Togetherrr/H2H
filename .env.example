NEXT_PUBLIC_SUPABASE_URL=project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=publishable-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Protects /api/realtime/poll (called by your cron every 5 minutes)
H2H_CRON_SECRET=change-me

# Spotify realtime (Chartex)
CHARTEX_APP_ID=your-app-id
CHARTEX_APP_TOKEN=your-app-token
# Optional override for Chartex songs endpoint path (default: /external/v1/songs/)
H2H_CHARTEX_SONGS_PATH=/external/v1/songs/

# YouTube realtime (Data API v3)
H2H_YOUTUBE_API_KEY=your-youtube-api-key
# Comma/space-separated video ids to track (max 50 per request)
H2H_YOUTUBE_VIDEO_IDS=F7sGJVUrkjQ,n7kFRxFIPrI,Ur7aK4FvK-U,kxUA2wwYiME,ufwB9Uja_wM,hJ9Wp3PO3c8
